<UserControl x:Class="GameStreamX.Desktop.Views.CloudDrivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Style="{StaticResource Primary}" Command="{Binding ConnectGoogleDriveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Sign in with Google Drive" />
                    </StackPanel>
                </Button>
                <Button Content="Add virtual drive" Command="{Binding AddDriveCommand}" CommandParameter="{x:Null}" />
            </StackPanel>

            <TextBlock Text="Virtual drives" Style="{StaticResource H2}" />
            <TextBlock Text="No drives yet. Connect an account, then add a drive." Style="{StaticResource Caption}" Margin="0,0,0,12"
                       Visibility="{Binding Drives.Count, Converter={StaticResource NotVis}}" />
            <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="10" Background="{StaticResource Surface3}" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Letter}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Open" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        Visibility="{Binding IsMounted, Converter={StaticResource Vis}}" />
                                <Button Content="Refresh listing" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        Visibility="{Binding IsMounted, Converter={StaticResource Vis}}" />
                                <Button Content="Unmount" Command="{Binding DataContext.UnmountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        Visibility="{Binding IsMounted, Converter={StaticResource Vis}}" />
                                <Button Content="Mount" Style="{StaticResource Primary}" Command="{Binding DataContext.MountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                        Visibility="{Binding IsMounted, Converter={StaticResource NotVis}}" />
                                <Button Content="Remove" Style="{StaticResource DangerButton}" Command="{Binding DataContext.RemoveDriveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding State}" FontSize="11" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Remote}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Connected accounts" Style="{StaticResource H2}" />
                        <TextBlock Text="None yet." Style="{StaticResource Caption}" Visibility="{Binding Accounts.Count, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Content="Disconnect" Style="{StaticResource Ghost}" Padding="8,3"
                                                Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <Button DockPanel.Dock="Right" Content="Add drive" Style="{StaticResource Ghost}" Padding="8,3"
                                                Command="{Binding DataContext.AddDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}" />
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" Width="130" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Value}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Cloud providers" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding ProviderRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Support}" Margin="10,0,0,0" Foreground="{Binding Tone, Converter={StaticResource Tone}}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
