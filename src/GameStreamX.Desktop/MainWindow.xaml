<Window x:Class="GameStreamX.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameStreamX.Desktop.ViewModels"
        xmlns:v="clr-namespace:GameStreamX.Desktop.Views"
        Title="GAMESTREAM X" Height="860" Width="1380" MinWidth="1100" MinHeight="680"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" Icon="Assets/gamestreamx.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CloudDrivesViewModel}"><v:CloudDrivesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameLibraryViewModel}"><v:GameLibraryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcceleratorViewModel}"><v:AcceleratorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SmartCacheViewModel}"><v:SmartCacheView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}"><v:PerformanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><v:DiagnosticsView /></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.RowSpan="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,24,16,22" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                        <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold">
                            <Run Text="GAMESTREAM" /><Run Text=" X" Foreground="{StaticResource Purple}" />
                        </TextBlock>
                        <TextBlock Text="Cloud-to-SSD engine" FontSize="10.5" Foreground="{StaticResource Dim}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Version}" Foreground="{StaticResource Dim}" FontSize="11" Margin="24,0,0,14" />
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="15" Width="26" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="32,26,32,10">
                <ProgressBar DockPanel.Dock="Right" Width="120" IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding Selected.Busy, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource H1}" />
            </DockPanel>
            <Border Grid.Row="1" Margin="32,0,32,12" CornerRadius="8" Padding="14,9" Background="{StaticResource Surface2}"
                    BorderBrush="{Binding Selected.MessageTone, Converter={StaticResource Tone}}" BorderThickness="1"
                    Visibility="{Binding Selected.Message, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding Selected.Message}" TextWrapping="Wrap" Foreground="{Binding Selected.MessageTone, Converter={StaticResource Tone}}" />
            </Border>
            <ContentControl Grid.Row="2" Content="{Binding Selected}" Margin="32,0,18,0" Focusable="False" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="32,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE8CE;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding DrivesStatus}" Foreground="{StaticResource Muted}" FontSize="11.5" />
                <TextBlock Text="{Binding RateStatus}" Foreground="{StaticResource Accent}" FontSize="11.5" Margin="18,0,0,0" />
                <TextBlock Text="{Binding EngineStatus}" Foreground="{StaticResource Purple}" FontSize="11.5" Margin="18,0,0,0" />
                <TextBlock Text="{Binding GameStatus}" Foreground="{StaticResource Success}" FontSize="11.5" Margin="18,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
